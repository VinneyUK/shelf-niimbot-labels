# Settings for shelf-labels.sh.
# Copy this to label-printer.env, fill it in, and keep it private:
#   cp label-printer.env.example label-printer.env && chmod 600 label-printer.env

# ---------------------------------------------------------------- Shelf
# The address you open Shelf at. Must match Shelf's own SERVER_URL exactly,
# because every QR code links here.
SHELF_URL=https://shelf.example.lan

# The Postgres container Shelf uses, and how to log in to it from inside.
# With the usual self-hosted Supabase setup these defaults are right.
DB_CONTAINER=shelf-db
DB_USER=postgres
DB_NAME=postgres

# The tag that means "print a label for this". Create it in Shelf first.
TAG_NAME=QRP

# The tag added once a label has printed, so Shelf shows which assets have one.
# Create it in Shelf too, or leave blank to add nothing.
DONE_TAG=QRU

# ------------------------------------------------------- Home Assistant
# As you'd type it in a browser
HA_URL=http://homeassistant.local:8123

# Long-lived access token: your profile (bottom left) → Security →
# Long-lived access tokens → Create token
HA_TOKEN=

# The printer's device ID: Settings → Devices & services → Devices → click the
# Niimbot. It's the long string at the end of the page address.
NIIMBOT_DEVICE_ID=

# ----------------------------------------------------------------- label
# Label length in printer dots (8 per mm): 240 for 30 mm, 320 for 40 mm.
# The printable height is fixed at 96 dots (12 mm), the D110/D11 printhead.
LABEL_WIDTH=240

# Space before the QR code, in dots (8 = 1 mm, 12 = 1.5 mm)
LEFT_MARGIN=8

# 90 normally; 270 if the text prints upside down
ROTATE=90

# Print darkness. Blank for the printer's default.
DENSITY=
